#!/bin/tcsh -f  


setenv PYTH /local/images/anaconda2_4.4.0/bin/python

set mmm=$0:r
set ddd=`echo 1 | awk 'BEGIN{cc="'$mmm'"}{for(l=1;l<=length(cc);l++) if(substr(cc,l,1)=="/") ip=l}END{print substr(cc,1,ip-1)}'`


echo "1st  round "
$ddd/scan_all_xgb_1.job 
$ddd/scan_all_xgb_1_kn.job > ! all_xgb_1.txt 

echo "2nd round "
$ddd/scan_all_xgb_2.job 
$ddd/scan_all_xgb_2_kn.job > ! all_xgb.txt 

